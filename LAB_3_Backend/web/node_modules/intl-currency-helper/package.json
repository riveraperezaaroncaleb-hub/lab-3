{
  "name": "intl-currency-helper",
  "version": "2.0.0",
  "description": "A lightweight, high-powered library for formatting numbers to currency using Intl.NumberFormat, optimized for both Node.js and React.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidFranco3/intl-currency-helper.git"
  },
  "bugs": {
    "url": "https://github.com/DavidFranco3/intl-currency-helper/issues"
  },
  "homepage": "https://github.com/DavidFranco3/intl-currency-helper#readme",
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node test.js",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch"
  },
  "keywords": [
    "currency",
    "format",
    "intl",
    "money",
    "react",
    "nodejs",
    "typescript"
  ],
  "author": "David Franco",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
